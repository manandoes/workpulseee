# Talking Lens Media environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database (PostgreSQL) ---
# Local development via docker-compose (see docker-compose.yml):
#   postgresql://workpulse:workpulse@localhost:5432/workpulse?schema=public
#
# On Vercel (or any serverless host), each request can run on a different
# instance, each opening its own connection pool — so this MUST point at a
# pooler built for that concurrency, not a plain Postgres connection.
# With Supabase: use the "Transaction" pooler connection string (port 6543),
# with `?pgbouncer=true` appended so Prisma skips named prepared statements
# (transaction-mode pooling doesn't support them). The "Session" pooler
# (port 5432) caps total clients far too low for serverless and will crash
# the app with "max clients reached" under real traffic — only use it for a
# single always-on server process (e.g. local dev, docker-compose).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Optional. Only needed when DATABASE_URL points at a pooler (as above).
# `prisma migrate` runs schema changes directly against Postgres and doesn't
# work through a transaction-mode pooler, so it needs its own unpooled
# connection. With Supabase: the "Direct connection" string. Not required
# for local dev against an already-unpooled Postgres (e.g. docker-compose).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Auth (NextAuth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of the app, used for callbacks and invite links.
NEXTAUTH_URL="http://localhost:3000"
# Required when self-hosting (outside Vercel): tells Auth.js it may trust the
# Host header of incoming requests. Set this wherever you deploy, and make sure
# the host is pinned at your proxy/load balancer.
AUTH_TRUST_HOST="true"

# --- Transactional email (employee invites, approval notifications) ---
# Added in Phase 2 when the invite flow is built.
#
# This is the FALLBACK sender, used only for a company that hasn't configured
# its own provider yet at Settings -> Email delivery (Owner-only). Once a
# company sets its own Resend or Brevo key there, its invites and
# notifications are sent from that identity instead — see
# lib/company-email-config.ts and lib/mailer.ts.
#
# Set ONE of the two keys below; that choice is what picks the fallback
# provider (Brevo wins if both are set). With neither, email is logged to the
# server console instead of being sent and the caller is told delivery did not
# happen — invites then show the admin a link to share by hand.
EMAIL_FROM="Talking Lens Media <noreply@example.com>"
RESEND_API_KEY=""
# Brevo requires that EMAIL_FROM's address be a verified sender on the account,
# and rejects any key used from an IP outside the account's allowlist when that
# feature is on (app.brevo.com/security/authorised_ips).
BREVO_API_KEY=""

# Encrypts each company's own email API key at rest (Settings -> Email
# delivery), the same AES-256-GCM-under-its-own-key pattern
# GOOGLE_TOKEN_ENCRYPTION_KEY below uses for Google refresh tokens. Generate
# with: openssl rand -base64 32
EMAIL_CONFIG_ENCRYPTION_KEY=""

# --- Object storage (attachments, avatars) ---
# Added in Phase 5 when task attachments are built.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Background jobs (Phase 6 — workload recalculation) ---
# Architecture.md section 2 names BullMQ + Redis for this. No queue infra
# exists yet and no host is chosen (see Memory.md's open Phase 0 blocker), so
# for now the recalculation sweep runs behind a plain HTTP endpoint instead of
# a worker process. Point your scheduler (Vercel Cron, GitHub Actions, a
# server cron job) at POST /api/jobs/recalculate-workload with this as the
# bearer token. Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- WhatsApp notifications (Phase 13 — Meta WhatsApp Business Cloud API) ---
# Leave empty and WhatsApp messages are logged to the server console instead of
# being sent, exactly like email above.
#
# Setup, in Meta Business Manager:
#   1. Create a Meta app of type Business and add the WhatsApp product.
#   2. Complete Business Verification. Until it is done you can only message a
#      handful of test numbers you add by hand.
#   3. Note the phone number ID of your sending number (not the number itself).
#   4. Create a permanent System User access token with whatsapp_business_messaging.
#      The token the dashboard shows you first expires in 24 hours.
#   5. Create the message template described in lib/whatsapp.ts — category
#      Utility, two body variables — and wait for Meta to approve it.
#
# Every message sent opens a billable conversation. All notifications this app
# sends are business-initiated, so each one is chargeable; there is no free tier
# outside a 24-hour window opened by the user messaging you first.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Must match the approved template's name and language exactly.
WHATSAPP_TEMPLATE_NAME="workpulse_notification"
WHATSAPP_TEMPLATE_LANGUAGE="en"

# --- Web Push notifications (Phase 13) ---
# Generate the pair with: npx web-push generate-vapid-keys
# These are a matched pair — replacing either one kills every existing
# subscription, and every browser has to opt in again.
# Leave empty and push is skipped, the same way email and WhatsApp are.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address push services use to reach you about your sending. A
# `mailto:` or an https URL.
VAPID_SUBJECT="mailto:noreply@example.com"

# --- Payments (Razorpay) — monthly subscription plans and extra employee
# seats (Plan: billing). Unlike email/WhatsApp/push above, this cannot
# degrade gracefully when unconfigured — `lib/razorpay.ts` throws rather than
# silently skipping a payment, so both keys are required before `/billing`
# checkout can work at all.
#
# From the Razorpay dashboard (Settings -> API Keys). Use the Test Mode keys
# for local development — Razorpay's test cards work end to end with them,
# nothing is actually charged.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Same value as RAZORPAY_KEY_ID, duplicated under NEXT_PUBLIC_ so the
# Checkout widget (which runs in the browser) can read it — the secret key
# never gets a public counterpart.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Google Calendar (Phase 17 — preview + in-app meetings, read + write) ---
# Leave empty and the whole feature degrades gracefully: the "Connect Google
# Calendar" button on /calendar shows as disabled with an explanation, and
# booking meetings inside WorkPulse itself still works fully without it.
#
# Setup, in Google Cloud Console:
#   1. Create a project (or reuse one) and enable the "Google Calendar API".
#   2. Configure the OAuth consent screen (External or Internal, your call).
#   3. Create an OAuth client ID of type "Web application", and add
#      GOOGLE_REDIRECT_URI below as an authorized redirect URI.
#
# Scope requested is `calendar.events` + `openid email` — read/write on
# events only (not full calendar management). When a person connects, booking
# or cancelling a meeting in WorkPulse also creates or deletes a real event on
# their Google Calendar, inviting any other connected participants; see
# lib/google-calendar.ts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"
# A refresh token must stay reversible (Google requires it back on every API
# call), so unlike every other secret this app stores it is encrypted, not
# hashed — AES-256-GCM under this key. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- SEO: Google Search Console ---
# Verifies domain ownership via the `verification.google` meta tag in
# app/layout.tsx. Get this from Search Console -> Settings -> Ownership
# verification -> HTML tag -> copy just the `content` attribute's value (not
# the whole <meta> tag). Optional: search still works without it, but Search
# Console won't show indexing/performance data until the property is verified.
GOOGLE_SITE_VERIFICATION=""
