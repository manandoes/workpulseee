# .env.production — hosted Supabase connection for production deployments
# Do NOT commit this file. Copy values from your Vercel/Supabase dashboard.
# This file exists so you have a template; fill it in when setting up production.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

AUTH_SECRET="<from-vercel-environment-variables>"
NEXTAUTH_URL="https://workpulse.automovalabs.tech"
AUTH_TRUST_HOST="true"
CRON_SECRET="<your-cron-secret>"

EMAIL_FROM="WorkPulse <noreply@automovalabs.tech>"
BREVO_API_KEY=""
EMAIL_CONFIG_ENCRYPTION_KEY=""

# Add production-specific values for WhatsApp, Google Calendar, etc. here.
# Most third-party keys can be shared with dev, but secrets should live in
# Vercel environment variables, not in this file.
